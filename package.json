{
  "name": "agentmart",
  "version": "1.0.0",
  "private": true,
  "description": "AgentMart seller and buyer applications",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:seller": "npm --prefix frontend/seller ci",
    "install:buyer": "npm --prefix frontend ci",
    "install:all": "npm run install:seller && npm run install:buyer && npm run install:seller:expo && npm run install:backend",
    "dev": "node frontend/scripts/dev.mjs",
    "frontend": "node frontend/scripts/dev.mjs",
    "seller": "npm --prefix frontend/seller run dev --",
    "seller:web": "npm --prefix frontend/seller run dev --",
    "buyer": "npm --prefix frontend/buyer start --",
    "buyer:web": "npm --prefix frontend/buyer run web --",
    "buyer:android": "npm --prefix frontend/buyer run android --",
    "buyer:ios": "npm --prefix frontend/buyer run ios --",
    "seller:build": "npm --prefix frontend/seller run build",
    "buyer:build": "npm --prefix frontend/buyer run build",
    "build": "npm run seller:build && npm run buyer:build && npm run seller:expo:build",
    "start": "npm --prefix frontend/seller start --",
    "seller:typecheck": "npm --prefix frontend/seller run typecheck",
    "buyer:typecheck": "npm --prefix frontend/buyer run typecheck",
    "typecheck": "npm run seller:typecheck && npm run buyer:typecheck && npm run seller:expo:typecheck",
    "buyer:lint": "npm --prefix frontend/buyer run lint",
    "seller:verify": "npm --prefix frontend/seller run verify",
    "buyer:verify": "npm --prefix frontend/buyer run verify",
    "seller:mobile:install": "npm --prefix frontend/seller/mobile ci",
    "seller:mobile:sync": "npm --prefix frontend/seller/mobile run sync",
    "seller:android": "npm --prefix frontend/seller/mobile run android",
    "seller:ios": "npm --prefix frontend/seller/mobile run ios",
    "seller:expo": "node frontend/scripts/dev.mjs --seller-expo",
    "seller:expo:web": "node frontend/scripts/dev.mjs --seller-expo --web",
    "install:seller:expo": "npm --prefix frontend/seller/expo ci",
    "seller:expo:build": "npm --prefix frontend/seller/expo run build",
    "seller:expo:typecheck": "npm --prefix frontend/seller/expo run typecheck",
    "seller:expo:lint": "npm --prefix frontend/seller/expo run lint",
    "backend:setup": "npm --prefix backend run setup",
    "backend:test": "npm --prefix backend test",
    "install:backend": "npm --prefix backend ci",
    "backend:typecheck": "npm --prefix backend run typecheck",
    "backend:dev": "npm --prefix backend run dev --"
  }
}
