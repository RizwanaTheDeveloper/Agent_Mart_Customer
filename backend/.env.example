NODE_ENV=development
APP_NAME=AgentMart API
HOST=0.0.0.0
PORT=4000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:8081,http://localhost:8083,http://127.0.0.1:8081,http://127.0.0.1:8083
SWAGGER_ENABLED=true

# Set your actual PostgreSQL connection URL before running migrations or seed.
# Example shape: postgresql://USER:PASSWORD@localhost:5432/agentmart?schema=public
# Empty in development: health is available, readiness returns 503.
# Production always requires a configured database.
DATABASE_URL=
DATABASE_REQUIRED=false

# Required for the authentication module. Generate locally with npm.cmd run auth:setup.
# When configured, use distinct secrets of at least 32 characters.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Upload settings are configuration only until an upload service is implemented.
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIRECTORY=uploads
MAX_UPLOAD_BYTES=5242880

# Existing Cloudflare Buyer/Seller API secrets remain in
# ignored frontend/seller/.dev.vars; these are separate runtimes.
