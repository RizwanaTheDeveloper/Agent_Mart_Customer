{
  "name": "agentmart-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Start AgentMart seller and buyer together",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/dev.mjs",
    "seller:expo": "node scripts/dev.mjs --seller-expo",
    "seller:expo:web": "node scripts/dev.mjs --seller-expo --web",
    "install:seller:expo": "npm --prefix seller/expo ci",
    "seller:expo:build": "npm --prefix seller/expo run build",
    "seller:expo:typecheck": "npm --prefix seller/expo run typecheck",
    "seller:expo:lint": "npm --prefix seller/expo run lint",
    "web": "expo start --web",
    "build": "expo export --platform all",
    "backend:setup": "npm --prefix ../backend run setup",
    "backend:test": "npm --prefix ../backend test",
    "test:master-plan": "node --experimental-strip-types scripts/test-master-plan.cjs",
    "test:apk-fields": "node --experimental-strip-types scripts/test-apk-fields.cjs",
    "test:api-requests": "node --experimental-strip-types --test scripts/test-api-requests.cjs",
    "test:seller-crda": "node --experimental-strip-types scripts/test-seller-crda.cjs"
  },
  "main": "expo-router/entry",
  "workspaces": [
    "buyer"
  ],
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.1.0",
    "expo-constants": "~58.0.16",
    "expo-font": "~58.0.12",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.33",
    "expo-secure-store": "~58.0.3",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  }
}
