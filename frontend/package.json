{
  "name": "agentmart-customer-frontend",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:go": "expo start --go --lan --clear",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "export:web": "expo export --platform web",
    "build:apk-assets": "node scripts/build-apk-assets.cjs",
    "prestart": "npm run build:apk-assets",
    "prestart:go": "npm run build:apk-assets",
    "preandroid": "npm run build:apk-assets",
    "preios": "npm run build:apk-assets",
    "preweb": "npm run build:apk-assets",
    "preexport:web": "npm run build:apk-assets"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "expo": "^58.0.0",
    "expo-constants": "~58.0.16",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.0",
    "react-native-webview": "14.0.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.0",
    "typescript": "~6.0.3"
  }
}
